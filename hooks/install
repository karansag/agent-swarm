#!/usr/bin/env python3
"""Install (or with --remove, uninstall) the agent-swarm startup hooks.

  Claude Code  SessionStart hook in ~/.claude/settings.json
  Codex        SessionStart hook in ~/.codex/hooks.json (trust it once via /hooks)
  Pi           extension linked at ~/.pi/agent/extensions/agent-swarm

Each runs `agent-swarm autoregister`, which registers the session only when
its harness runs straight in its own tmux pane. JSON files are backed up to
<file>.bak-<time> before they change.
"""

import json
import os
import shutil
import sys
import time
from pathlib import Path

COMMAND = "agent-swarm autoregister --hook"
HERE = Path(__file__).resolve().parent
HOME = Path.home()
STAMP = time.strftime("%Y%m%d-%H%M%S")


def edit_hooks(path: Path, remove: bool) -> None:
    config = json.loads(path.read_text()) if path.exists() else {}
    groups = config.setdefault("hooks", {}).setdefault("SessionStart", [])
    kept = [g for g in groups if not any(h.get("command") == COMMAND for h in g.get("hooks", []))]
    if not remove:
        kept.append({"hooks": [{"type": "command", "command": COMMAND, "timeout": 15}]})
    if kept == groups:
        print(f"{path}: unchanged")
        return
    config["hooks"]["SessionStart"] = kept
    if not kept:
        del config["hooks"]["SessionStart"]
    if not config["hooks"]:
        del config["hooks"]
    if path.exists():
        shutil.copy2(path, f"{path}.bak-{STAMP}")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(config, indent=2) + "\n")
    print(f"{path}: {'removed' if remove else 'added'} SessionStart hook")


def link_pi(remove: bool) -> None:
    agent_dir = Path(os.environ.get("PI_CODING_AGENT_DIR") or HOME / ".pi/agent")
    dest = agent_dir / "extensions/agent-swarm"
    if dest.is_symlink():
        dest.unlink()
    elif dest.exists():
        sys.exit(f"{dest} exists and is not a link; move it away first")
    if remove:
        print(f"{dest}: removed")
        return
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.symlink_to(HERE / "pi/agent-swarm")
    print(f"{dest} -> {HERE / 'pi/agent-swarm'}")


def main() -> None:
    remove = "--remove" in sys.argv[1:]
    edit_hooks(HOME / ".claude/settings.json", remove)
    edit_hooks(Path(os.environ.get("CODEX_HOME") or HOME / ".codex") / "hooks.json", remove)
    link_pi(remove)
    if not remove:
        print("Codex skips new hooks until trusted: run /hooks in Codex once and trust it.")


if __name__ == "__main__":
    main()
