#!/usr/bin/env bash
set -euo pipefail

AGENT_SWARM_PROJECT="${AGENT_SWARM_PROJECT:-${AGENT_MSG_PROJECT:-${HOME}/agent-swarm}}"
# The exact model id is what the dashboard shows. Prefer --model, then the
# env, then the top-level `model = "..."` in Codex's config; send nothing
# rather than a placeholder so a label already on record is kept.
codex_config_model() {
  local config="${CODEX_HOME:-${HOME}/.codex}/config.toml"
  [[ -f "$config" ]] || return 0
  awk '/^\[/ { exit } /^[[:space:]]*model[[:space:]]*=/ { sub(/^[^=]*=[[:space:]]*"/, ""); sub(/".*$/, ""); print; exit }' "$config"
}
model="${CODEX_MODEL:-$(codex_config_model)}"
default_instructions="Codex agent; send normal agent-swarm messages. No /queue prefix is needed."
has_instructions=0

if [[ "${1:-}" == "--whoami" ]]; then
  shift
  if command -v agent-swarm >/dev/null 2>&1; then
    exec agent-swarm whoami "$@"
  fi
  exec uv run --project "$AGENT_SWARM_PROJECT" agent-swarm whoami "$@"
fi

extra_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --agent-id|--pane|--name|--instructions|--message-prefix|--submit-key|--model)
      if [[ $# -lt 2 ]]; then
        echo "error: $1 requires a value" >&2
        exit 2
      fi
      if [[ "$1" == "--model" ]]; then
        model="$2"
      elif [[ "$1" == "--instructions" ]]; then
        has_instructions=1
        extra_args+=("$1" "$2")
      else
        extra_args+=("$1" "$2")
      fi
      shift 2
      ;;
    --flavor)
      echo "error: this helper always registers Codex agents with --flavor codex" >&2
      exit 2
      ;;
    --user|--handle)
      echo "error: use --name to request a handle" >&2
      exit 2
      ;;
    *)
      echo "error: unknown option $1" >&2
      exit 2
      ;;
  esac
done

if [[ "$has_instructions" -eq 0 ]]; then
  extra_args+=(--instructions "$default_instructions")
fi

args=(register)
if [[ -n "$model" ]]; then
  args+=(--model "$model")
fi
args+=(--flavor codex ${extra_args[@]+"${extra_args[@]}"})

if command -v agent-swarm >/dev/null 2>&1; then
  exec agent-swarm "${args[@]}"
fi

exec uv run --project "$AGENT_SWARM_PROJECT" agent-swarm "${args[@]}"
