#!/usr/bin/env bash
# Link the shared agent-swarm skill from this checkout into the directories
# the harnesses scan, so edits in the repo reach every agent:
#   ~/.agents/skills  Codex and Pi
#   ~/.claude/skills  Claude Code
# An old copy at a target is moved to a backup beside the skills directory,
# never inside it, where it would load twice. Links an earlier version of this
# script left in ~/.codex/skills or ~/.pi/agent/skills are removed for the
# same reason.
set -euo pipefail

repo_skills="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
stamp="$(date +%Y%m%d-%H%M%S)"

link() {
  local src="$1" dest_dir="$2"
  local dest="$dest_dir/$(basename "$src")"
  mkdir -p "$dest_dir"
  if [[ -e "$dest" && ! -L "$dest" ]]; then
    local backup="$dest_dir.bak-$stamp"
    mkdir -p "$backup"
    mv "$dest" "$backup/"
    echo "moved old copy to $backup/$(basename "$src")"
  fi
  ln -sfn "$src" "$dest"
  echo "$dest -> $src"
}

unlink_old() {
  local dest="$1"
  if [[ -L "$dest" && "$(readlink "$dest")" == "$repo_skills"/* ]]; then
    rm "$dest"
    echo "removed old link $dest"
  fi
}

for skill in "$repo_skills"/*/; do
  name="$(basename "$skill")"
  link "${skill%/}" "${HOME}/.agents/skills"
  link "${skill%/}" "${HOME}/.claude/skills"
  unlink_old "${CODEX_HOME:-${HOME}/.codex}/skills/$name"
  unlink_old "${PI_CODING_AGENT_DIR:-${HOME}/.pi/agent}/skills/$name"
done
